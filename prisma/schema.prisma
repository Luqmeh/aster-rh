// Schéma Prisma ASTER — PostgreSQL (Supabase).
// Les données calendrier RH sont dérivées des congés / télétravail (pas de table CalendarEvent).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Prisma 6 : un seul env() par champ (pas de fallback natif).
  // Mapping Vercel Supabase → ces noms : see database-env.ts / scripts/with-prisma-env.ts
  // DATABASE_URL ← POSTGRES_PRISMA_URL (poolée) ; DIRECT_URL ← POSTGRES_URL_NON_POOLING.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DemoRole {
  collaborateur
  chef_de_projet
  admin_rh
}

enum EmployeeCategory {
  cadre
  non_cadre
}

enum ContractType {
  cdi
  cdd
  alternance
  stage
}

enum RequestStatus {
  brouillon
  soumise
  en_attente_manager
  en_attente_rh
  approuvee
  refusee
  annulee
}

enum LeaveType {
  conges_payes
  rtt
  sans_solde
  maladie
  exceptionnel
  parental
}

enum TeleworkType {
  regulier
  occasionnel
  exceptionnel
}

enum AuthProvider {
  credentials
  entra_id
}

enum EmploymentStatus {
  actif
  inactif
  parti
}

enum RecruitmentStatus {
  brouillon
  soumis_revue
  refuse
  approuve
  intervieweur_assigne
  entretien_planifie
  entretien_termine
}

enum DocumentRequestType {
  attestation_travail
  attestation_employeur
  attestation_remuneration
  copie_contrat
  copie_avenant
  attestation_formation
  attestation_cncc
  certificat_travail
  attestation_france_travail
  recu_solde_tout_compte
  autre
}

enum DocumentRequestStatus {
  en_attente
  en_traitement
  informations_demandees
  document_disponible
  refusee
}

/// Compte applicatif ASTER — distinct de la fiche Employee (données RH).
model UserAccount {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String?
  authProvider    AuthProvider
  /// Subject Microsoft Entra (oid) lorsque authProvider = entra_id.
  externalSubject String?
  role            DemoRole
  employeeId      String       @unique
  employee        Employee     @relation(fields: [employeeId], references: [id])
  isActive        Boolean      @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  roleChangeAudits RoleChangeAudit[] @relation("RoleChangeTarget")

  @@unique([authProvider, externalSubject])
  @@index([role])
  @@index([isActive])
}

/// Historique d'attribution de rôles (audit serveur).
model RoleChangeAudit {
  id              String   @id @default(cuid())
  targetAccountId String
  targetAccount   UserAccount @relation("RoleChangeTarget", fields: [targetAccountId], references: [id], onDelete: Cascade)
  previousRole    DemoRole
  newRole         DemoRole
  actorEmployeeId String
  actorEmployee   Employee @relation("RoleChangeActor", fields: [actorEmployeeId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())

  @@index([targetAccountId])
  @@index([actorEmployeeId])
  @@index([createdAt])
}

model OrganizationUnit {
  id          String             @id
  name        String
  code        String             @unique
  parentId    String?
  parent      OrganizationUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children    OrganizationUnit[] @relation("OrgTree")
  employees   Employee[]
  recruitments RecruitmentCandidate[]

  @@index([parentId])
}

model Employee {
  id                  String             @id
  demoIdentityId      String?
  firstName           String
  lastName            String
  email               String             @unique
  jobTitle            String
  departmentId        String
  department          OrganizationUnit   @relation(fields: [departmentId], references: [id])
  managerId           String?
  manager             Employee?          @relation("Management", fields: [managerId], references: [id])
  reports             Employee[]         @relation("Management")
  site                String
  contractType        ContractType
  category            EmployeeCategory
  hireDate            DateTime
  /// Cycle de vie RH — source de vérité ; isActive reste synchronisé (accès).
  employmentStatus    EmploymentStatus   @default(actif)
  departureDate       DateTime?
  departureNote       String?
  isActive            Boolean            @default(true)
  phoneInternal       String?
  avatarInitials      String
  teleworkEligible    Boolean            @default(true)
  teleworkDaysPerWeek Int                @default(2)
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  teleworkRequests    TeleworkRequest[]
  notifications       NotificationItem[]
  documents           HrDocument[]
  userAccount         UserAccount?
  roleChangeAudits    RoleChangeAudit[]  @relation("RoleChangeActor")
  recruitmentCreated  RecruitmentCandidate[] @relation("RecruitmentCreator")
  recruitmentDecided  RecruitmentCandidate[] @relation("RecruitmentDecider")
  interviewsAssigned  RecruitmentCandidate[] @relation("RecruitmentInterviewer")
  documentRequests    DocumentRequest[]      @relation("DocumentRequestEmployee")
  documentRequestsProcessed DocumentRequest[] @relation("DocumentRequestProcessor")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([demoIdentityId])
  @@index([managerId])
  @@index([departmentId])
  @@index([isActive])
  @@index([employmentStatus])
}

/// Candidat recrutement externe — distinct d'une fiche Employee.
model RecruitmentCandidate {
  id                    String            @id @default(cuid())
  fullName              String
  email                 String
  phone                 String?
  positionTitle         String
  departmentId          String?
  department            OrganizationUnit? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  cvStorageKey          String?
  cvFileName            String?
  cvContentType         String?
  hrNotes               String?
  status                RecruitmentStatus @default(brouillon)
  submittedAt           DateTime?
  createdByEmployeeId   String
  createdBy             Employee          @relation("RecruitmentCreator", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  decidedByEmployeeId   String?
  decidedBy             Employee?         @relation("RecruitmentDecider", fields: [decidedByEmployeeId], references: [id], onDelete: SetNull)
  decisionComment       String?
  decidedAt             DateTime?
  interviewerEmployeeId String?
  interviewer           Employee?         @relation("RecruitmentInterviewer", fields: [interviewerEmployeeId], references: [id], onDelete: SetNull)
  assignedByEmployeeId  String?
  assignedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  events                RecruitmentEvent[]

  @@index([status])
  @@index([createdByEmployeeId])
  @@index([interviewerEmployeeId])
  @@index([email])
  @@index([positionTitle])
  @@index([submittedAt])
}

model RecruitmentEvent {
  id          String               @id @default(cuid())
  candidateId String
  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind        String
  message     String
  actorId     String?
  createdAt   DateTime             @default(now())

  @@index([candidateId])
  @@index([createdAt])
}

model LeaveBalance {
  id                  String   @id @default(cuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year                Int
  congesPayesAcquis   Float
  congesPayesPris     Float
  congesPayesRestants Float
  rttAcquis           Float
  rttPris             Float
  rttRestants         Float

  @@unique([employeeId, year])
  @@index([employeeId])
}

model LeaveRequest {
  id             String        @id
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           LeaveType
  startDate      DateTime
  endDate        DateTime
  halfDayStart   Boolean       @default(false)
  halfDayEnd     Boolean       @default(false)
  daysCount      Float
  status         RequestStatus
  comment        String?
  managerComment String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([employeeId, status])
}

model TeleworkRequest {
  id             String        @id
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           TeleworkType
  /// Mois planifié (yyyy-mm) pour les plans mensuels.
  month          String?
  startDate      DateTime
  endDate        DateTime
  days           String[]
  status         RequestStatus
  reason         String?
  managerComment String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([month])
  @@index([employeeId, month])
  @@index([employeeId, status])
}

model NotificationItem {
  id          String   @id
  recipientId String
  recipient   Employee @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  title       String
  body        String
  href        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId])
  @@index([recipientId, read])
  @@index([createdAt])
}

model HrDocument {
  id            String    @id
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  title         String
  category      String
  uploadedAt    DateTime  @default(now())
  storageKey    String
  isCompanyWide Boolean   @default(false)

  @@index([employeeId])
  @@index([isCompanyWide])
}

/// Demande documentaire collaborateur → traitement RH / Chef.
model DocumentRequest {
  id                     String                @id @default(cuid())
  employeeId             String
  employee               Employee              @relation("DocumentRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  documentType           DocumentRequestType
  customLabel            String?
  reason                 String
  status                 DocumentRequestStatus @default(en_attente)
  hrMessage              String?
  hrInternalNote         String?
  storageKey             String?
  fileName               String?
  contentType            String?
  published              Boolean               @default(false)
  publishedAt            DateTime?
  processedByEmployeeId  String?
  processedBy            Employee?             @relation("DocumentRequestProcessor", fields: [processedByEmployeeId], references: [id], onDelete: SetNull)
  events                 DocumentRequestEvent[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([documentType])
  @@index([employeeId, status])
  @@index([createdAt])
}

model DocumentRequestEvent {
  id        String          @id @default(cuid())
  requestId String
  request   DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind      String
  message   String
  actorId   String?
  createdAt DateTime        @default(now())

  @@index([requestId])
  @@index([createdAt])
}

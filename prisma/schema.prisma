// Schéma Prisma ASTER — PostgreSQL (Supabase).
// Les données calendrier RH sont dérivées des congés / télétravail (pas de table CalendarEvent).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Prisma 6 : un seul env() par champ (pas de fallback natif).
  // Mapping Vercel Supabase → ces noms : see database-env.ts / scripts/with-prisma-env.ts
  // DATABASE_URL ← POSTGRES_PRISMA_URL (poolée) ; DIRECT_URL ← POSTGRES_URL_NON_POOLING.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DemoRole {
  collaborateur
  chef_de_projet
  admin_rh
}

/// Classification héritée FR (`cadre`/`non_cadre`) conservée pour historique.
/// Maroc : préférer `non_applicable` + `policyGroup` — ne pas piloter les droits via cadre.
enum EmployeeCategory {
  cadre
  non_cadre
  non_applicable
}

enum ContractType {
  cdi
  cdd
  alternance
  stage
}

enum RequestStatus {
  brouillon
  soumise
  en_attente_manager
  en_attente_rh
  approuvee
  refusee
  annulee
}

enum LeaveType {
  conges_payes
  rtt
  recuperation
  sans_solde
  maladie
  exceptionnel
  parental
}

/// Comptes suivis par le grand livre des congés (Phase 1 + 2).
enum LeaveLedgerAccount {
  /// Legacy / agrégat Phase 1 — ouvertures historiques CP.
  conges_payes
  /// CP acquis (période N-1 close + reports) — guide p.38–48.
  conges_payes_acquis
  /// CP en cours d'acquisition (juin N → mai N+1).
  conges_payes_en_acquisition
  rtt
  recuperation
}

enum EntitlementPolicyKind {
  conges_payes
  rtt
  recuperation_usage
  special_leave
  carryover_cp
  expiry_rtt
}

enum EntitlementValidationStatus {
  guide_documented
  requires_hr_decision
  hr_configured
  draft
}

enum AccrualBatchStatus {
  preview
  posted
  cancelled
}

enum CarryoverRequestStatus {
  brouillon
  en_attente_validation
  approuvee
  refusee
}

enum LeaveLedgerUnit {
  days
  hours
}

enum LeaveLedgerTransactionType {
  opening_balance
  accrual
  leave_consumption
  recovery_credit
  recovery_consumption
  carryover
  expiry
  hr_adjustment
  reversal
}

enum WorkOnHolidayStatus {
  en_attente
  approuvee
  refusee
  travail_effectue_a_confirmer
  confirmee_credit_appliquee
}

enum HolidayKind {
  national
  religious
  company
}

enum HolidayConfirmation {
  confirmed
  provisional
}

enum TeleworkType {
  regulier
  occasionnel
  exceptionnel
}

enum AuthProvider {
  credentials
  entra_id
}

enum EmploymentStatus {
  actif
  inactif
  parti
}

enum RecruitmentStatus {
  brouillon
  soumis_revue
  refuse
  approuve
  intervieweur_assigne
  entretien_planifie
  entretien_termine
}

enum DocumentRequestType {
  attestation_travail
  attestation_employeur
  attestation_remuneration
  copie_contrat
  copie_avenant
  attestation_formation
  attestation_cncc
  certificat_travail
  attestation_france_travail
  recu_solde_tout_compte
  autre
}

enum DocumentRequestStatus {
  en_attente
  en_traitement
  informations_demandees
  document_disponible
  refusee
}

enum AbsenceFamily {
  arret
  conge_special
}

enum WorkAbsenceCategory {
  arret_maladie
  accident_travail
  accident_trajet
  maladie_professionnelle
  conge_maternite
  conge_paternite
  conge_pathologique
  prolongation_arret
  rechute
  mariage_pacs
  naissance_adoption
  deces_proche
  demenagement
  hospitalisation_enfant
  annonce_handicap_ald
  rdv_medicaux_handicap
  preparation_examen_alternant
}

enum WorkAbsenceStatus {
  declare
  en_attente_justificatif
  en_cours_verification
  informations_demandees
  enregistre
  termine
  refuse
}

enum AbsenceDocumentKind {
  certificat_initial
  certificat_prolongation
  bulletin_hospitalisation
  dossier_at_mp
  calendrier_maternite
  notification_paternite
  justificatif_special
  autre
}

enum ReturnVisitStatus {
  non_applicable
  a_planifier
  planifiee
  realisee
  non_requise
}

/// Compte applicatif ASTER — distinct de la fiche Employee (données RH).
model UserAccount {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String?
  authProvider    AuthProvider
  /// Subject Microsoft Entra (oid) lorsque authProvider = entra_id.
  externalSubject String?
  role            DemoRole
  employeeId      String       @unique
  employee        Employee     @relation(fields: [employeeId], references: [id])
  isActive        Boolean      @default(true)
  /// true après provisioning avec mot de passe temporaire — accès limité jusqu'au changement.
  mustChangePassword Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  roleChangeAudits RoleChangeAudit[] @relation("RoleChangeTarget")

  @@unique([authProvider, externalSubject])
  @@index([role])
  @@index([isActive])
}

/// Historique d'attribution de rôles (audit serveur).
model RoleChangeAudit {
  id              String   @id @default(cuid())
  targetAccountId String
  targetAccount   UserAccount @relation("RoleChangeTarget", fields: [targetAccountId], references: [id], onDelete: Cascade)
  previousRole    DemoRole
  newRole         DemoRole
  actorEmployeeId String
  actorEmployee   Employee @relation("RoleChangeActor", fields: [actorEmployeeId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())

  @@index([targetAccountId])
  @@index([actorEmployeeId])
  @@index([createdAt])
}

model OrganizationUnit {
  id          String             @id
  name        String
  code        String             @unique
  parentId    String?
  parent      OrganizationUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children    OrganizationUnit[] @relation("OrgTree")
  employees   Employee[]
  recruitments RecruitmentCandidate[]

  @@index([parentId])
}

model Employee {
  id                  String             @id
  demoIdentityId      String?
  firstName           String
  lastName            String
  email               String             @unique
  jobTitle            String
  departmentId        String
  department          OrganizationUnit   @relation(fields: [departmentId], references: [id])
  managerId           String?
  manager             Employee?          @relation("Management", fields: [managerId], references: [id])
  reports             Employee[]         @relation("Management")
  site                String
  contractType        ContractType
  category            EmployeeCategory
  hireDate            DateTime
  /// Cycle de vie RH — source de vérité ; isActive reste synchronisé (accès).
  employmentStatus    EmploymentStatus   @default(actif)
  departureDate       DateTime?
  departureNote       String?
  isActive            Boolean            @default(true)
  phoneInternal       String?
  avatarInitials      String
  teleworkEligible    Boolean            @default(true)
  teleworkDaysPerWeek Int                @default(2)
  /// Heures / jour pour conversion récupération férié → jours (hypothèse démo).
  standardDailyHours  Float              @default(7)
  /// Temps partiel — si true sans barème validé → calcul « requires_hr_validation ».
  isPartTime          Boolean            @default(false)
  /// Heures hebdomadaires contractuelles (null = non renseigné).
  weeklyContractHours Float?
  /// Pourcentage d'activité (null = non renseigné). Ne pas multiplier silencieusement les CP.
  workingTimePercent  Float?
  /// Calendrier de bureau (ex. calculs employeur) — null si non configuré.
  officeCalendarId    String?
  officeCalendar      OfficeWorkCalendar? @relation(fields: [officeCalendarId], references: [id])
  /// Groupe de politique employeur (Maroc) — indépendant du titre / ancien cadre.
  policyGroup         String?
  /// Date de naissance (art. 231 — régime moins de 18 ans). Nullable.
  birthDate           DateTime?          @db.Date
  /// Secteur pour art. 238-2 (191 h non agricole / 208 h agricole).
  activitySector      String?            @default("non_agricole")
  leaveBalances       LeaveBalance[]
  leaveLedgerEntries  LeaveLedgerEntry[]
  leaveRequests       LeaveRequest[]
  teleworkRequests    TeleworkRequest[]
  accrualLines        AccrualLine[]
  carryoverRequests   CarryoverRequest[]
  notifications       NotificationItem[]
  documents           HrDocument[]
  userAccount         UserAccount?
  roleChangeAudits    RoleChangeAudit[]  @relation("RoleChangeActor")
  recruitmentCreated  RecruitmentCandidate[] @relation("RecruitmentCreator")
  recruitmentDecided  RecruitmentCandidate[] @relation("RecruitmentDecider")
  interviewsAssigned  RecruitmentCandidate[] @relation("RecruitmentInterviewer")
  documentRequests    DocumentRequest[]      @relation("DocumentRequestEmployee")
  documentRequestsProcessed DocumentRequest[] @relation("DocumentRequestProcessor")
  workOnHolidayRequests WorkOnHolidayRequest[] @relation("WorkOnHolidayEmployee")
  workOnHolidayDecisions WorkOnHolidayRequest[] @relation("WorkOnHolidayDecider")
  workOnHolidayConfirmations WorkOnHolidayRequest[] @relation("WorkOnHolidayConfirmer")
  holidayOverridesCreated HolidayOverride[] @relation("HolidayOverrideCreator")
  recoveryCredits     RecoveryCreditLedger[] @relation("RecoveryCreditEmployee")
  recoveryCreditsActed RecoveryCreditLedger[] @relation("RecoveryCreditActor")
  workAbsences        WorkAbsence[]          @relation("WorkAbsenceEmployee")
  workAbsencesProcessed WorkAbsence[]        @relation("WorkAbsenceProcessor")
  workAbsenceDocumentsUploaded WorkAbsenceDocument[] @relation("WorkAbsenceDocUploader")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([demoIdentityId])
  @@index([managerId])
  @@index([departmentId])
  @@index([isActive])
  @@index([employmentStatus])
}

/// Candidat recrutement externe — distinct d'une fiche Employee.
model RecruitmentCandidate {
  id                    String            @id @default(cuid())
  fullName              String
  email                 String
  phone                 String?
  positionTitle         String
  departmentId          String?
  department            OrganizationUnit? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  cvStorageKey          String?
  cvFileName            String?
  cvContentType         String?
  hrNotes               String?
  status                RecruitmentStatus @default(brouillon)
  submittedAt           DateTime?
  createdByEmployeeId   String
  createdBy             Employee          @relation("RecruitmentCreator", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  decidedByEmployeeId   String?
  decidedBy             Employee?         @relation("RecruitmentDecider", fields: [decidedByEmployeeId], references: [id], onDelete: SetNull)
  decisionComment       String?
  decidedAt             DateTime?
  interviewerEmployeeId String?
  interviewer           Employee?         @relation("RecruitmentInterviewer", fields: [interviewerEmployeeId], references: [id], onDelete: SetNull)
  assignedByEmployeeId  String?
  assignedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  events                RecruitmentEvent[]

  @@index([status])
  @@index([createdByEmployeeId])
  @@index([interviewerEmployeeId])
  @@index([email])
  @@index([positionTitle])
  @@index([submittedAt])
}

model RecruitmentEvent {
  id          String               @id @default(cuid())
  candidateId String
  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind        String
  message     String
  actorId     String?
  createdAt   DateTime             @default(now())

  @@index([candidateId])
  @@index([createdAt])
}

model LeaveBalance {
  id                  String   @id @default(cuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year                Int
  congesPayesAcquis   Float
  congesPayesPris     Float
  congesPayesRestants Float
  rttAcquis           Float
  rttPris             Float
  rttRestants         Float
  recoveryDaysAcquis  Float    @default(0)
  recoveryDaysPris    Float    @default(0)
  recoveryDaysRestants Float   @default(0)

  @@unique([employeeId, year])
  @@index([employeeId])
}

/// Grand livre append-only des mouvements de congés (source de vérité Phase 1).
/// Les corrections passent par des écritures de compensation / reversal — jamais d'UPDATE/DELETE métier.
model LeaveLedgerEntry {
  id              String                     @id @default(cuid())
  employeeId      String
  employee        Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  account         LeaveLedgerAccount
  transactionType LeaveLedgerTransactionType
  /// Quantité signée (crédit > 0, débit < 0), Decimal(12,4).
  quantity        Decimal                    @db.Decimal(12, 4)
  unit            LeaveLedgerUnit            @default(days)
  year            Int
  effectiveDate   DateTime                   @db.Date
  createdAt       DateTime                   @default(now())
  sourceKind      String
  sourceId        String
  reason          String
  actorEmployeeId String?
  reversesEntryId String?
  reversesEntry   LeaveLedgerEntry?          @relation("LeaveLedgerReversal", fields: [reversesEntryId], references: [id])
  reversedBy      LeaveLedgerEntry[]         @relation("LeaveLedgerReversal")
  metadataJson    Json?

  @@unique([sourceKind, sourceId, transactionType])
  @@index([employeeId, account, year])
  @@index([employeeId, year])
  @@index([effectiveDate])
  @@index([createdAt])
  @@index([sourceKind, sourceId])
}

model LeaveRequest {
  id             String        @id
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           LeaveType
  startDate      DateTime
  endDate        DateTime
  halfDayStart   Boolean       @default(false)
  halfDayEnd     Boolean       @default(false)
  daysCount      Float
  status         RequestStatus
  comment        String?
  managerComment String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([employeeId, status])
}

model TeleworkRequest {
  id             String        @id
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           TeleworkType
  /// Mois planifié (yyyy-mm) pour les plans mensuels.
  month          String?
  startDate      DateTime
  endDate        DateTime
  days           String[]
  status         RequestStatus
  reason         String?
  managerComment String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([month])
  @@index([employeeId, month])
  @@index([employeeId, status])
}

model NotificationItem {
  id          String   @id
  recipientId String
  recipient   Employee @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  title       String
  body        String
  href        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId])
  @@index([recipientId, read])
  @@index([createdAt])
}

model HrDocument {
  id            String    @id
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  title         String
  category      String
  uploadedAt    DateTime  @default(now())
  storageKey    String
  isCompanyWide Boolean   @default(false)

  @@index([employeeId])
  @@index([isCompanyWide])
}

/// Demande documentaire collaborateur → traitement RH / Chef.
model DocumentRequest {
  id                     String                @id @default(cuid())
  employeeId             String
  employee               Employee              @relation("DocumentRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  documentType           DocumentRequestType
  customLabel            String?
  reason                 String
  status                 DocumentRequestStatus @default(en_attente)
  hrMessage              String?
  hrInternalNote         String?
  storageKey             String?
  fileName               String?
  contentType            String?
  published              Boolean               @default(false)
  publishedAt            DateTime?
  processedByEmployeeId  String?
  processedBy            Employee?             @relation("DocumentRequestProcessor", fields: [processedByEmployeeId], references: [id], onDelete: SetNull)
  events                 DocumentRequestEvent[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([documentType])
  @@index([employeeId, status])
  @@index([createdAt])
}

model DocumentRequestEvent {
  id        String          @id @default(cuid())
  requestId String
  request   DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind      String
  message   String
  actorId   String?
  createdAt DateTime        @default(now())

  @@index([requestId])
  @@index([createdAt])
}

/// Corrections RH / jours entreprise — le jeu curated reste versionné dans le dépôt.
model HolidayOverride {
  id                  String              @id @default(cuid())
  sourceKey           String
  date                DateTime
  nameFr              String
  kind                HolidayKind
  confirmation        HolidayConfirmation @default(confirmed)
  isActive            Boolean             @default(true)
  year                Int
  createdByEmployeeId String?
  createdBy           Employee?           @relation("HolidayOverrideCreator", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([sourceKey, year])
  @@index([date])
  @@index([year])
}

model WorkOnHolidayRequest {
  id                     String              @id @default(cuid())
  employeeId             String
  employee               Employee            @relation("WorkOnHolidayEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  holidayDate            DateTime
  holidaySourceKey       String
  holidayName            String
  plannedHours           Float
  plannedStart           String?
  plannedEnd             String?
  reason                 String
  status                 WorkOnHolidayStatus @default(en_attente)
  decidedByEmployeeId    String?
  decidedBy              Employee?           @relation("WorkOnHolidayDecider", fields: [decidedByEmployeeId], references: [id], onDelete: SetNull)
  decisionComment        String?
  decidedAt              DateTime?
  actualHours            Float?
  actualDeclaredAt       DateTime?
  confirmedHours         Float?
  confirmedByEmployeeId  String?
  confirmedBy            Employee?           @relation("WorkOnHolidayConfirmer", fields: [confirmedByEmployeeId], references: [id], onDelete: SetNull)
  confirmedAt            DateTime?
  creditLedgerId         String?             @unique
  creditLedger           RecoveryCreditLedger? @relation(fields: [creditLedgerId], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([employeeId])
  @@index([holidayDate])
  @@index([status])
  @@index([employeeId, holidayDate])
}

/// Arrêts de travail & congés spéciaux (distinct des LeaveRequest CP/RTT).
model WorkAbsence {
  id                         String               @id @default(cuid())
  employeeId                 String
  employee                   Employee             @relation("WorkAbsenceEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  family                     AbsenceFamily
  category                   WorkAbsenceCategory
  status                     WorkAbsenceStatus    @default(declare)
  startDate                  DateTime
  endDate                    DateTime
  daysCount                  Float
  employeeComment            String?
  hrInternalNote             String?
  hrMessage                  String?
  rejectionReason            String?
  parentAbsenceId            String?
  parentAbsence              WorkAbsence?         @relation("AbsenceExtension", fields: [parentAbsenceId], references: [id], onDelete: SetNull)
  extensions                 WorkAbsence[]        @relation("AbsenceExtension")
  recurrenceOfId             String?
  recurrenceOf               WorkAbsence?         @relation("AbsenceRecurrence", fields: [recurrenceOfId], references: [id], onDelete: SetNull)
  recurrences                WorkAbsence[]        @relation("AbsenceRecurrence")
  dateGapFlag                Boolean              @default(false)
  recurrenceWithin3MonthsFlag Boolean             @default(false)
  requiresHrReview           Boolean              @default(false)
  hospitalAdmissionDate      DateTime?
  hospitalDischargeDate      DateTime?
  documentsReceived          Boolean              @default(false)
  firstDocumentReceivedAt    DateTime?
  payrollProcessingMonth     String?
  expectedReturnDate         DateTime?
  actualReturnDate           DateTime?
  returnVisitRequired        Boolean              @default(false)
  returnVisitStatus          ReturnVisitStatus    @default(non_applicable)
  returnVisitPlannedDate     DateTime?
  returnVisitDeadline        DateTime?
  processedByEmployeeId      String?
  processedBy                Employee?            @relation("WorkAbsenceProcessor", fields: [processedByEmployeeId], references: [id], onDelete: SetNull)
  processedAt                DateTime?
  documents                  WorkAbsenceDocument[]
  events                     WorkAbsenceEvent[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([category])
  @@index([family])
  @@index([startDate])
  @@index([endDate])
  @@index([parentAbsenceId])
  @@index([employeeId, status])
}

model WorkAbsenceDocument {
  id                   String              @id @default(cuid())
  absenceId            String
  absence              WorkAbsence         @relation(fields: [absenceId], references: [id], onDelete: Cascade)
  kind                 AbsenceDocumentKind
  fileName             String
  contentType          String
  storageKey           String
  uploadedByEmployeeId String
  uploadedBy           Employee            @relation("WorkAbsenceDocUploader", fields: [uploadedByEmployeeId], references: [id], onDelete: Restrict)
  receivedByHrAt       DateTime?
  createdAt            DateTime            @default(now())

  @@index([absenceId])
  @@index([uploadedByEmployeeId])
}

model WorkAbsenceEvent {
  id        String      @id @default(cuid())
  absenceId String
  absence   WorkAbsence @relation(fields: [absenceId], references: [id], onDelete: Cascade)
  kind      String
  message   String
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([absenceId])
  @@index([createdAt])
}

/// Ledger auditable des crédits de récupération (1 h confirmée = 1 h crédit).
model RecoveryCreditLedger {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation("RecoveryCreditEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  year             Int
  sourceKind       String
  sourceRequestId  String   @unique
  hoursConfirmed   Float
  daysCredited     Float
  dailyHoursUsed   Float
  actorEmployeeId  String
  actor            Employee @relation("RecoveryCreditActor", fields: [actorEmployeeId], references: [id], onDelete: Restrict)
  workOnHoliday    WorkOnHolidayRequest?
  createdAt        DateTime @default(now())

  @@index([employeeId])
  @@index([year])
  @@index([sourceRequestId])
}

/// Calendrier de bureau pour calcul RTT cadres (7–11 j) — guide p.38–48.
/// Absent ou non validé → calcul RTT cadre « requires_hr_validation ».
model OfficeWorkCalendar {
  id              String     @id @default(cuid())
  code            String     @unique
  label           String
  siteKey         String?
  /// Jours fériés tombant un jour ouvré (ISO dates) pour une période RTT.
  workingHolidays Json       @default("[]")
  validationStatus EntitlementValidationStatus @default(draft)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  employees       Employee[]

  @@index([siteKey])
}

/// Politique d'acquisition versionnée (métadonnées persistées ; règles guide aussi en code).
model EntitlementPolicy {
  id          String                 @id @default(cuid())
  kind        EntitlementPolicyKind
  code        String                 @unique
  label       String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  versions    EntitlementPolicyVersion[]
}

model EntitlementPolicyVersion {
  id               String                      @id @default(cuid())
  policyId         String
  policy           EntitlementPolicy           @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version          Int
  effectiveFrom    DateTime                    @db.Date
  effectiveTo      DateTime?                   @db.Date
  validationStatus EntitlementValidationStatus @default(draft)
  /// FR = guide France (historique) ; MA = Maroc ; UNSET = legacy.
  jurisdiction     String                      @default("UNSET")
  /// false = désactivée pour preview/post (historique conservé).
  isActive         Boolean                     @default(true)
  /// Paramètres JSON (taux, plafonds, arrondi, population, période d'acquisition…).
  rulesJson        Json
  sourceReference  String
  notes            String?
  createdByEmployeeId String?
  createdAt        DateTime                    @default(now())
  accrualLines     AccrualLine[]

  @@unique([policyId, version])
  @@index([effectiveFrom])
  @@index([validationStatus])
  @@index([jurisdiction, isActive])
}

/// Lot d'acquisition (preview puis posting contrôlé) — pas de scheduler silencieux.
model AccrualBatch {
  id              String            @id @default(cuid())
  periodKey       String
  label           String
  status          AccrualBatchStatus @default(preview)
  createdByEmployeeId String?
  postedByEmployeeId  String?
  createdAt       DateTime          @default(now())
  postedAt        DateTime?
  notes           String?
  lines           AccrualLine[]

  @@index([periodKey])
  @@index([status])
  @@index([createdAt])
}

model AccrualLine {
  id                String            @id @default(cuid())
  batchId           String
  batch             AccrualBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  account           LeaveLedgerAccount
  policyVersionId   String?
  policyVersion     EntitlementPolicyVersion? @relation(fields: [policyVersionId], references: [id], onDelete: SetNull)
  periodKey         String
  /// Quantité crédit proposée / postée (jours).
  quantity          Decimal           @db.Decimal(12, 4)
  calculationStatus String
  explanation       String
  warningsJson      Json              @default("[]")
  idempotencyKey    String            @unique
  ledgerEntryId     String?
  postedAt          DateTime?
  createdAt         DateTime          @default(now())

  @@index([batchId])
  @@index([employeeId, periodKey])
  @@index([calculationStatus])
}

/// Lot d'import Excel collaborateurs / soldes d'ouverture (département Maroc).
model HrImportBatch {
  id                      String   @id
  status                  String
  fileName                String
  storageKey              String?
  createdByEmployeeId     String
  confirmedByEmployeeId   String?
  updateExistingEmployees Boolean  @default(false)
  columnMappingJson       Json     @default("{}")
  departmentMappingJson   Json     @default("{}")
  siteMappingJson         Json     @default("{}")
  previewSummaryJson      Json?
  executionReportJson     Json?
  worksheetNamesJson      Json     @default("[]")
  headersBySheetJson      Json     @default("{}")
  employeeDraftsJson      Json     @default("[]")
  balanceDraftsJson       Json     @default("[]")
  errorMessage            String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  executedAt              DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([createdByEmployeeId])
}

/// Demande de report CP (plafond 5 j ; exceptions partenaire / RRH — guide p.38–48).
model CarryoverRequest {
  id                    String                 @id @default(cuid())
  employeeId            String
  employee              Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sourcePeriodKey       String
  targetPeriodKey       String
  requestedDays         Decimal                @db.Decimal(12, 4)
  status                CarryoverRequestStatus @default(brouillon)
  exceptionReason       String?
  leavePlanThrough      DateTime?              @db.Date
  partnerApprovedById   String?
  partnerApprovedAt     DateTime?
  rrhForwardedAt        DateTime?
  decidedByEmployeeId   String?
  decidedAt             DateTime?
  decisionNote          String?
  ledgerCarryoverEntryId String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([sourcePeriodKey])
}

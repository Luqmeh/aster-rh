# ASTER — variables d'environnement (placeholders uniquement)
# Copier vers .env.local pour le développement. Ne jamais committer de secrets.
# Les scripts db:* chargent .env / .env.local via @next/env, puis mappent POSTGRES_*.

# Mode application : demo (défaut) | futur: connected
ASTER_MODE=demo

# Persistance : memory | prisma
ASTER_PERSISTENCE=memory

# Secours uniquement (jamais pour la démo board hébergée)
# ASTER_ALLOW_MEMORY=1

# Build Next.js sans base (défini automatiquement par npm run build / fin de build:vercel)
# ASTER_BUILD_WITHOUT_DB=1

# Migrations pendant build Vercel
# ASTER_MIGRATE_ON_BUILD=1
# ASTER_SKIP_MIGRATE=1

# Seed démo one-shot (Production) — retirer après succès
# ASTER_SEED_ON_BUILD=1
# Mot de passe temporaire des comptes seed (jamais committer la vraie valeur)
# ASTER_SEED_PASSWORD=

# Auth.js — secret de session (obligatoire en runtime hébergé)
AUTH_SECRET="generate-a-long-random-secret"
# URL canonique HTTPS de l’app (recommandé sur Vercel, ex. https://aster.vercel.app)
# AUTH_URL="https://YOUR-DEPLOYMENT.vercel.app"

# Fournisseurs d'authentification
# Identifiants temporaires (prototype) — désactiver avec 0 pour SSO exclusif
ASTER_CREDENTIALS_AUTH=1
# Microsoft Entra ID — activer seulement si les 3 variables ci-dessous sont renseignées
ASTER_ENTRA_AUTH=0
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/TENANT_ID/v2.0

# PostgreSQL — développement local (.env.local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Vercel + intégration Supabase :
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# Base isolée pour tests d’intégration (optionnel)
# ASTER_TEST_DATABASE_URL=
# ASTER_TEST_DIRECT_URL=

# Supabase Storage (CV recrutement — bucket privé obligatoire en Production)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
# Doit rester aster-private-docs en Production (défaut)
# ASTER_STORAGE_BUCKET="aster-private-docs"
# Secours local uniquement — interdit sur la démo board
# ASTER_ALLOW_MOCK_STORAGE=1

# E-mail (futur)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

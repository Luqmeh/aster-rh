# ASTER — variables d'environnement (placeholders uniquement)
# Copier vers .env.local pour le développement. Ne jamais committer de secrets.

# Mode application : demo (défaut) | futur: connected
ASTER_MODE=demo

# Persistance : memory | prisma
# - Omit / memory : magasin mémoire (dev local sans PostgreSQL)
# - prisma : PostgreSQL via Prisma (requis pour Vercel / démo board durable)
# Si omit et DATABASE_URL (ou POSTGRES_PRISMA_URL) est défini → prisma automatiquement.
ASTER_PERSISTENCE=memory

# Secours uniquement (jamais pour la démo board hébergée)
# ASTER_ALLOW_MEMORY=1

# Build Next.js sans base (défini automatiquement par npm run build)
# ASTER_BUILD_WITHOUT_DB=1

# PostgreSQL — développement local (.env.local)
# DATABASE_URL = pooler (runtime applicatif, port 6543 typiquement)
# DIRECT_URL   = connexion directe (migrations Prisma, port 5432)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Vercel + intégration Supabase officielle :
# ne pas dupliquer les credentials. L’app mappe automatiquement :
#   POSTGRES_PRISMA_URL      → DATABASE_URL  (requêtes poolées)
#   POSTGRES_URL_NON_POOLING → DIRECT_URL    (migrations)
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# Base isolée pour tests d’intégration (optionnel — jamais une base partagée)
# ASTER_TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aster_test?sslmode=require"
# ASTER_TEST_DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/aster_test?sslmode=require"

# Supabase (futur — ne pas renseigner de vraies clés en dépôt)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Microsoft Entra ID (futur SSO — non branché en démo)
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""

# E-mail (futur)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
